    {
        "tablename":  "marks",
        "policyname":  "p_marks_teacher",
        "cmd":  "INSERT",
        "roles":  "{public}",
        "qual":  null,
        "with_check":  "((get_my_role() = \u0027teacher\u0027::text) AND (EXISTS ( SELECT 1\n   FROM (((teachers t\n     JOIN teacher_subjects ts ON ((ts.teacher_id = t.id)))\n     JOIN student_enrollments se ON (((se.class_stream_id = ts.class_stream_id) AND (se.academic_year_id = ts.academic_year_id))))\n     JOIN exams e ON (((e.id = marks.exam_id) AND (e.academic_year_id = ts.academic_year_id))))\n  WHERE ((t.profile_id = auth.uid()) AND (ts.subject_id = marks.subject_id) AND (se.student_id = marks.student_id)))))"
    },
    {
        "tablename":  "marks",
        "policyname":  "p_marks_teacher_delete",
        "cmd":  "DELETE",
        "roles":  "{public}",
        "qual":  "((get_my_role() = \u0027teacher\u0027::text) AND (EXISTS ( SELECT 1\n   FROM exams e\n  WHERE ((e.id = marks.exam_id) AND (e.status = \u0027entering_marks\u0027::text)))) AND (EXISTS ( SELECT 1\n   FROM (teachers t\n     JOIN teacher_subjects ts ON ((ts.teacher_id = t.id)))\n  WHERE ((t.profile_id = auth.uid()) AND (ts.subject_id = marks.subject_id)))))",
        "with_check":  null
    },
    {
        "tablename":  "marks",
        "policyname":  "p_marks_teacher_update",
        "cmd":  "UPDATE",
        "roles":  "{public}",
        "qual":  "((get_my_role() = \u0027teacher\u0027::text) AND (EXISTS ( SELECT 1\n   FROM (((teachers t\n     JOIN teacher_subjects ts ON ((ts.teacher_id = t.id)))\n     JOIN student_enrollments se ON (((se.class_stream_id = ts.class_stream_id) AND (se.academic_year_id = ts.academic_year_id))))\n     JOIN exams e ON (((e.id = marks.exam_id) AND (e.academic_year_id = ts.academic_year_id))))\n  WHERE ((t.profile_id = auth.uid()) AND (ts.subject_id = marks.subject_id) AND (se.student_id = marks.student_id)))))",
        "with_check":  null
    },
